# ============================================================
# Design DaaS stack configuration
# ============================================================
#
# One file for the three parts of the stack:
#   - DaaS backend (Python, this repo)        https://<host>        (nginx :443)
#   - Frontend (React)                        https://<host>:8443   (nginx :8443)
#   - auth service (users, OAuth, permissions) https://<host>:8443/auth (nginx -> :8080)
#
# Usage:
#   cp daas.env.example daas.env      # in installer/, daas.env is not committed
#   edit daas.env
#   make install                      # everything; see README.md or `make help`
#
# Format: KEY=value, one per line, no spaces around "=". Values are taken
# literally (no $variable expansion); surrounding quotes are removed.
# Leave a value empty to use the default shown in the comment.

# ------------------------------------------------------------
# Host
# ------------------------------------------------------------

HOST_NAME=pve1
HOST_DOMAIN=daas-design.de
# Main IP of this host (written to /etc/hosts by proxmox-install)
HOST_IP=10.0.2.15
# Last octet of this host on the DaaS networks (vmbr0/vmbr1/...)
HOST_NUMBER=11
# Network device bridged into vmbr0 (ignored when STANDALONE is set)
NET_DEVICE=enp0s4
# Non-empty (e.g. yes) for a single host without uplink bridge
STANDALONE=

# ------------------------------------------------------------
# Repositories
# ------------------------------------------------------------

# Default: next to this repo (../design-daas-application-frontend)
FRONTEND_FOLDER=
# Default: next to this repo (../design-daas-backend-java)
AUTH_FOLDER=

# ------------------------------------------------------------
# Public URLs (what the browser uses)
# ------------------------------------------------------------
# Defaults are derived from HOST_NAME.HOST_DOMAIN. Set them when users reach
# the host under another name (DNS alias, reverse proxy, ...).

# Default: https://HOST_NAME.HOST_DOMAIN
DAAS_PUBLIC_URL=
# Default: https://HOST_NAME.HOST_DOMAIN:8443
FRONTEND_PUBLIC_URL=
# Default: FRONTEND_PUBLIC_URL/auth (nginx proxies /auth/ to the auth service)
AUTH_PUBLIC_URL=

# ------------------------------------------------------------
# Authentication (DaaS backend <-> auth service)
# ------------------------------------------------------------

# remote: users log in through the auth service (recommended)
# local:  no login, every request runs as one fixed user
DAAS_AUTH_MODE=remote
# Also ask the auth service for a permission on every DaaS endpoint.
# The permission is named after the endpoint (e.g. vmlist, vmstatus, see
# name= in src/app/plugins/**/*_routes.py), so only enable this after
# creating those endpoints and granting them in the auth service; until
# then every request is denied.
DAAS_AUTH_CHECK_ENDPOINTS=false
# OAuth client id sent by DaaS and the frontend
OAUTH_CLIENT_ID=test-client

# Root password of the DaaS backend's MariaDB (daas-0-mariadb, data in
# src/data/db/mariadb). Baked into its image (make db-install) and written to
# src/config/local/db.toml. Only applied when the data folder is created.
# Letters and digits only (it is part of a connection URL). CHANGE IT.
DAAS_DB_PASSWORD=change-me-daas-db

# Proxmox API account the DaaS backend uses (daas@pve, Administrator).
# Written to src/config/local/vm.toml, never into git. CHANGE IT.
PVE_API_PASSWORD=change-me-pve

# Admin account, created by the auth service on its first start.
# The DaaS backend also logs in with it to check permissions, so it must
# be an admin. CHANGE BOTH.
ADMIN_EMAIL=admin@design.local
ADMIN_PASSWORD=change-me-admin

# ------------------------------------------------------------
# auth service
# ------------------------------------------------------------

# Port on 127.0.0.1 (nginx and the DaaS backend connect here)
AUTH_PORT=8080
# Spring profile: prod (no Swagger UI) or dev (Swagger UI on /auth/swagger-ui.html)
AUTH_PROFILE=prod
# Its own MariaDB container (daas-auth-db). CHANGE THE PASSWORDS.
AUTH_DB_NAME=design_backend
AUTH_DB_USER=design
AUTH_DB_PASSWORD=change-me-db
AUTH_DB_ROOT_PASSWORD=change-me-db-root
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# Mail for registration codes (optional). Gmail needs an App Password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@design.local
