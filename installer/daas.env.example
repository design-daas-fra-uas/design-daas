# ============================================================
# Design DaaS stack configuration
# ============================================================
#
# One file for the three parts of the stack:
#   - DaaS backend (Python, this repo)
#   - Frontend (React)	https://<host>:8443   (nginx :8443)
#   - auth service (users, OAuth, permissions)
#
# Usage:
#   cp daas.env.example daas.env      # in installer/, daas.env is not committed
#   edit daas.env
#   make install                      # everything; see README.md or `make help`
#
# Format: KEY=value, one per line, no spaces around "=". Values are taken
# literally (no $variable expansion); surrounding quotes are removed.
# Leave a value empty to use the default shown in the comment.

# ------------------------------------------------------------
# Host
# ------------------------------------------------------------

HOST_NAME=pve1
HOST_DOMAIN=daas-design.de
# Main IP of this host (written to /etc/hosts by proxmox-install). Leave it
# EMPTY: the installer then takes the IP of the default route. A value that
# is not an address of this host stops the install before it changes anything
HOST_IP=
# Last octet of this host on the DaaS networks (vmbr0/vmbr1/...)
HOST_NUMBER=11
# The host's network device (see `ip -br -4 addr`). Clustered host: bridged
# into vmbr0. STANDALONE: daas-configure runs dhclient on it once, because
# Proxmox sets the physical devices to "manual" (no address of their own)
NET_DEVICE=enp0s4
# Non-empty (e.g. yes) for a single host without uplink bridge
STANDALONE=YES

# ------------------------------------------------------------
# Repositories
# ------------------------------------------------------------

# Default: next to this repo (../design-daas-application-frontend)
FRONTEND_FOLDER=
# Default: next to this repo (../design-daas-backend-java)
AUTH_FOLDER=

# ------------------------------------------------------------
# Public URLs (what the browser uses)
# ------------------------------------------------------------
# Normally: LEAVE ALL THREE EMPTY. Then everything runs under the one name
# HOST_NAME.HOST_DOMAIN (e.g. pve1.daas-design.de):
#   Frontend      https://pve1.daas-design.de:8443     (nginx :8443)
#
# Set them only when the browser reaches the host under other names (DNS
# alias, reverse proxy, or the test names of use-hostnames.bash). Rules:
#   - Every host name in them must resolve to HOST_IP on the computers with
#     the browser: `make client-hosts` prints the hosts file line.
#   - nginx always serves the DaaS backend on 443 and the frontend on 8443;
#     other ports only work behind a proxy of your own.
#   - AUTH_PUBLIC_URL must be FRONTEND_PUBLIC_URL/auth: nginx serves the auth
#     service only there. So leave it empty, it follows the frontend.
#   - The certificate covers every name used here (make daas-configure).
#   - FRONTEND_PUBLIC_URL and AUTH_PUBLIC_URL are baked into the builds: after
#     changing them run make daas-configure frontend-configure auth-install
#     frontend-install daas-restart (use-hostnames.bash does exactly that).
# HOST_NAME itself is also the Proxmox node name: never change it after the
# install just to get another URL, set these instead.

# Default: https://HOST_NAME.HOST_DOMAIN
DAAS_PUBLIC_URL=
# Default: https://HOST_NAME.HOST_DOMAIN:8443
FRONTEND_PUBLIC_URL=
# Default: FRONTEND_PUBLIC_URL/auth (nginx proxies /auth/ to the auth service)
AUTH_PUBLIC_URL=

# ------------------------------------------------------------
# Authentication (DaaS backend <-> auth service)
# ------------------------------------------------------------

# remote: users log in through the auth service (recommended)
# local:  no login, every request runs as one fixed user
DAAS_AUTH_MODE=remote
# Also ask the auth service for a permission on every DaaS endpoint.
# The permission is named after the endpoint (e.g. vmlist, vmstatus, see
# name= in src/app/plugins/**/*_routes.py), so only enable this after
# creating those endpoints and granting them in the auth service; until
# then every request is denied.
DAAS_AUTH_CHECK_ENDPOINTS=true
# OAuth client id sent by DaaS and the frontend
OAUTH_CLIENT_ID=test-client

# Superuser (postgres) password of the stack's PostgreSQL (daas-0-postgres,
# data in src/data/db/postgres). Baked into its image (make db-install) and
# written to src/config/local/db.toml. Only applied when the data folder is
# created. CHANGE IT.
DAAS_DB_PASSWORD=change-me-daas-db

# Proxmox API account the DaaS backend uses (daas@pve, Administrator).
# Written to src/config/local/vm.toml, never into git. CHANGE IT.
PVE_API_PASSWORD=change-me-pve

# Admin account, created by the auth service on its first start.
# The DaaS backend also logs in with it to check permissions, so it must
# be an admin. CHANGE BOTH.
ADMIN_EMAIL=admin@design.local
ADMIN_PASSWORD=change-me-admin

# ------------------------------------------------------------
# auth service
# ------------------------------------------------------------

# Port on 127.0.0.1 (nginx and the DaaS backend connect here)
AUTH_PORT=8080
# Spring profile: prod (no Swagger UI) or dev (Swagger UI on /auth/swagger-ui.html)
AUTH_PROFILE=prod
# Its database and user in the DaaS PostgreSQL (daas-0-postgres, next to the
# DaaS backend's mergedb); auth-install creates them and sets the password.
# CHANGE THE PASSWORD.
AUTH_DB_NAME=design_backend
AUTH_DB_USER=design
AUTH_DB_PASSWORD=change-me-db
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=30

# Mail for registration codes (optional). Gmail needs an App Password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@design.local
